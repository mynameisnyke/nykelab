{
  // Prototype: one Worker = Hono API (shared with ../worker/src) + Astro pages.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nykelab-astro",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serve /journal (not /journal/) so links and canonical URLs match without a redirect.
  "assets": { "binding": "ASSETS", "html_handling": "drop-trailing-slash" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nykelab",
      "migrations_dir": "../worker/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nykelab-media" }],
  // Astro sessions (the adapter adds this binding itself; naming the existing namespace stops wrangler
  // from trying to create a second one on every deploy).
  "kv_namespaces": [{ "binding": "SESSION", "id": "c6e0df0f085f44c981dbd72aae7ed382" }],
  // Sized WebP variants are generated from originals on demand (see ../worker/src/public.ts).
  "images": { "binding": "IMAGES" },
  // Event tracking: every page / photo / video event is written here (worker/src/events.ts); the admin Stats tab reads it back.
  // If a deploy ever fails with error 10089, Analytics Engine is not enabled on the account (dashboard > Storage & databases >
  // Analytics Engine): enable it, or comment this line out. The public view counter does not depend on it (it lives in D1).
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "nykelab_events" }],
  "vars": {
    // Production by default: anything other than "development" makes /admin and /api/admin/* require a valid
    // Cloudflare Access login (and answers 503 until the two ACCESS_ values below are set). Local development
    // overrides this in .dev.vars (gitignored). See README, "Going live".
    "ENVIRONMENT": "production",
    // Cloudflare Access application "nykelab-astro" (identifiers, not secrets: every visitor is redirected with them).
    "ACCESS_TEAM_DOMAIN": "throbbing-sunset-0d23.cloudflareaccess.com",
    "ACCESS_AUD": "ce52f956a600b918ce10f711aca0f5352d44f6296aafae26a3ccedc5e151aad2",
    // Optional comma-separated allowlist of admin emails (extra check on top of Access).
    "ADMIN_EMAILS": ""
  },
  // The live domain: NOT enabled yet. Declaring `routes` makes Wrangler switch the *.workers.dev address off by default, and the
  // attach fails while the zone still has the old A records (error 100117), which leaves nothing serving. To enable, once those
  // records are deleted in the Cloudflare dashboard: uncomment, then `npm run deploy`.
  //   , "workers_dev": true,
  //   "routes": [{ "pattern": "nykelab.nyc", "custom_domain": true }, { "pattern": "www.nykelab.nyc", "custom_domain": true }]
}
