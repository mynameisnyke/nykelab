---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  published?: Date;
}
const { title, description, image, type = "website", published } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="nykelab journal" href="/journal/rss.xml" />

    <meta property="og:site_name" content="nykelab" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />

    <!-- Apply the saved theme before first paint (default: dark, like the Figma). -->
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        document.documentElement.dataset.theme = localStorage.getItem("theme") || "dark";
      } catch {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // Registered once; survives ClientRouter navigations.
  import { track } from "../lib/track";
  const root = document.documentElement;

  // Fires on first load and after every client-side navigation.
  document.addEventListener("astro:page-load", () => track("page_view"));

  function setTheme(theme: string) {
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {}
  }
  function setMenu(open: boolean) {
    const menu = document.getElementById("menu");
    if (!menu) return;
    menu.hidden = !open;
    root.dataset.menu = open ? "open" : "closed";
    document.querySelectorAll("[data-menu-open]").forEach((b) => b.setAttribute("aria-expanded", String(open)));
    if (open) menu.querySelector<HTMLElement>("[data-menu-close]")?.focus();
  }

  document.addEventListener("click", (e) => {
    const t = e.target as Element;
    if (t.closest("[data-theme-toggle]")) setTheme(root.dataset.theme === "light" ? "dark" : "light");
    else if (t.closest("[data-menu-open]")) setMenu(true);
    else if (t.closest("[data-menu-close]") || t.closest("#menu a")) setMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });

  // Keep the theme across page swaps.
  document.addEventListener("astro:before-swap", (e) => {
    (e as any).newDocument.documentElement.dataset.theme = root.dataset.theme;
  });
  document.addEventListener("astro:after-swap", () => {
    root.classList.add("js");
    setMenu(false);
  });
</script>
