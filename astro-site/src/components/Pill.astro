---
// Figma: Pill (Surface=Page, Size=Default | Small)
interface Props {
  label: string;
  href?: string;
  size?: "default" | "small";
  current?: boolean;
  /** "media" = sits over a photo: white outline/text in both themes. */
  surface?: "page" | "media";
  external?: boolean;
  /** Render a <button> (filters) instead of a link/span. */
  button?: boolean;
}
const { label, href, size = "default", current = false, surface = "page", external = false, button = false } = Astro.props;
const Tag = button ? "button" : href ? "a" : "span";
---

<Tag
  class:list={["pill", { small: size === "small", current, media: surface === "media" }]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  type={button ? "button" : undefined}
  aria-pressed={button ? (current ? "true" : "false") : undefined}
  aria-current={!button && current ? "page" : undefined}>{label}</Tag
>

<style>
  button.pill {
    background: transparent;
    cursor: pointer;
    font-family: var(--font-ui);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 12px;
    line-height: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }
  .pill.small {
    padding: 8px 16px;
    font-size: 11px;
    line-height: 13px;
  }
  .pill.media {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }
  .pill.media:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  a.pill:hover,
  .pill.current {
    background: var(--fill-ring-soft);
  }
</style>
