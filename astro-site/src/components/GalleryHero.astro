---
// Full-bleed cover for Place / Year galleries (Figma: GALLERIES hero). The year uses a huge numeral.
import MediaItem from "./MediaItem.astro";
import type { Photo } from "../lib/collections";
import type { PreviewImage } from "../lib/voyages";

interface Props {
  title: string;
  subtitle: string;
  crumb: { label: string; href: string };
  image?: PreviewImage;
  /** A clip for the hero; it wins over any still. */
  video?: Photo;
  /** A still that is sharp enough to fill the screen (heroOk); it wins over `image`. */
  photo?: Photo;
  numeral?: boolean;
}
const { title, subtitle, crumb, image, video, photo, numeral = false } = Astro.props;
---

<section class="hero">
  {video && <MediaItem media={video} eager fit="cover" sizes="100vw" />}
  {!video && photo && <MediaItem media={photo} eager fit="cover" sizes="100vw" />}
  {!video && !photo && image && <img class="media" src={image.src} srcset={image.srcset} sizes="100vw" alt={image.alt} loading="eager" decoding="async" fetchpriority="high" />}
  <div class="scrim top"></div>
  <div class="scrim bottom"></div>
  <a class="crumb eyebrow" href={crumb.href}>← {crumb.label}</a>
  <div class="text">
    <h1 class:list={{ numeral }}>{title}</h1>
    <p class="caption">{subtitle}</p>
  </div>
  <span class="caption scroll">Scroll</span>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    color: #fff;
  }
  .hero :global(.media),
  .media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scrim {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
  }
  .scrim.top {
    top: 0;
    height: 200px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), transparent);
  }
  .scrim.bottom {
    bottom: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  }
  .crumb {
    position: absolute;
    left: var(--inset);
    top: 96px;
    color: #e6e6e6;
  }
  .crumb:hover {
    color: #fff;
  }
  .text {
    position: absolute;
    left: var(--inset);
    right: var(--inset);
    bottom: 128px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 64px;
    line-height: 72px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  h1.numeral {
    font-size: 300px;
    line-height: 320px;
    text-transform: none;
    letter-spacing: -0.03em;
  }
  .text .caption {
    margin: 16px 0 0;
    color: #e6e6e6;
  }
  .scroll {
    position: absolute;
    right: var(--inset);
    bottom: 48px;
    color: #e6e6e6;
  }
  @media (max-width: 767px) {
    .crumb {
      top: 84px;
    }
    .text {
      bottom: 100px;
    }
    h1 {
      font-size: 40px;
      line-height: 46px;
    }
    h1.numeral {
      font-size: 160px;
      line-height: 170px;
    }
    .scroll {
      display: none;
    }
  }
</style>
