---
// Figma: ChapterNav. Same destinations as the menu's top level; voyages live only in the menu.
const items = [
  { label: "Home", href: "/" },
  { label: "Places", href: "/places" },
  { label: "Years", href: "/years" },
  { label: "Journal", href: "/journal" },
  { label: "About", href: "/about" },
];
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? here === "/" : here === href || here.startsWith(`${href}/`));
---

<nav class="chapter-nav" aria-label="Site">
  {
    items.map((it) => (
      <a href={it.href} data-astro-reload={it.href === "/" ? "" : undefined} class:list={{ active: isActive(it.href) }} aria-current={isActive(it.href) ? "page" : undefined}>
        {it.label}
      </a>
    ))
  }
</nav>

<style>
  .chapter-nav {
    position: fixed;
    left: var(--inset);
    right: var(--inset);
    bottom: 32px;
    z-index: 20;
    display: flex;
    gap: 22px;
    overflow-x: auto;
    scrollbar-width: none;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13px;
    line-height: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    mix-blend-mode: difference; /* legible over any photo */
  }
  .chapter-nav::-webkit-scrollbar {
    display: none;
  }
  a {
    display: inline-flex;
    gap: 8px;
    flex: none;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  a:hover,
  a.active {
    opacity: 1;
  }
  @media (max-width: 767px) {
    .chapter-nav {
      gap: 16px;
      font-size: 11px;
      bottom: 20px;
    }
  }
</style>
