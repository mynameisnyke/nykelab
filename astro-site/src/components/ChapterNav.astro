---
// Figma: ChapterNav. Same destinations as the menu's top level (src/lib/nav.ts); voyages live only in the menu.
import InfinityMark from "./InfinityMark.astro";
import { NAV_ITEMS, isHere } from "../lib/nav";
const items = NAV_ITEMS;
const isActive = (href: string) => isHere(href, Astro.url.pathname);
---

<nav class="chapter-nav" aria-label="Site">
  {
    items.map((it) => (
      <a
        href={it.href}
        data-astro-reload={it.href === "/" || it.icon ? "" : undefined}
        class:list={{ active: isActive(it.href), mark: !!it.icon }}
        aria-current={isActive(it.href) ? "page" : undefined}
        aria-label={it.icon ? it.label : undefined}
        title={it.icon ? it.label : undefined}
      >
        {it.icon === "infinity" ? <InfinityMark size={20} /> : it.label}
      </a>
    ))
  }
</nav>

<style>
  .chapter-nav {
    position: fixed;
    left: var(--inset);
    right: var(--inset);
    bottom: 32px;
    z-index: 20;
    display: flex;
    gap: 22px;
    overflow-x: auto;
    scrollbar-width: none;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13px;
    line-height: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    mix-blend-mode: difference; /* legible over any photo */
  }
  .chapter-nav::-webkit-scrollbar {
    display: none;
  }
  a {
    display: inline-flex;
    gap: 8px;
    flex: none;
    opacity: 0.7; /* inactive: 0.5 measured below 4.5:1 on the light page */
    transition: opacity 0.2s ease;
  }
  a:hover,
  a.active {
    opacity: 1;
  }
  a.mark {
    align-items: center;
    margin-left: -4px; /* the mark has its own side bearing */
  }
  @media (max-width: 767px) {
    .chapter-nav {
      gap: 16px;
      font-size: 11px;
      bottom: 20px;
    }
  }
</style>
