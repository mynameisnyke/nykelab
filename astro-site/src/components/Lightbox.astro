---
// Click-to-enlarge overlay for a page's photographs, driven by src/scripts/lightbox.ts (from initPhotos). Hidden until a
// photograph is clicked; one per page.
---

<div id="lightbox" class="lb" role="dialog" aria-modal="true" aria-label="Photograph" hidden>
  <div class="lb-backdrop"></div>
  <figure class="lb-fig"><img class="lb-img" alt="" decoding="async" draggable="false" /></figure>
  <button class="lb-close eyebrow" type="button">Close</button>
  <button class="lb-arrow lb-prev" type="button" aria-label="Previous photograph">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="1.25" /></svg>
  </button>
  <button class="lb-arrow lb-next" type="button" aria-label="Next photograph">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.25" /></svg>
  </button>
  <div class="lb-bar">
    <p class="caption lb-cap"></p>
    <p class="eyebrow lb-count"></p>
  </div>
</div>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 200;
    color: #e6e6e6;
    touch-action: none;
    overscroll-behavior: contain;
    user-select: none;
    -webkit-user-select: none;
  }
  .lb[hidden] {
    display: none;
  }
  .lb-backdrop {
    position: absolute;
    inset: 0;
    background: #050505;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .lb-close,
  .lb-arrow,
  .lb-bar {
    opacity: 0;
    transition: opacity 0.4s ease 0.15s;
  }
  .lb.open .lb-backdrop,
  .lb.open .lb-close,
  .lb.open .lb-arrow,
  .lb.open .lb-bar {
    opacity: 1;
  }
  .lb-fig {
    position: fixed;
    margin: 0;
    overflow: hidden;
    background: #000;
    transform-origin: 0 0;
    will-change: transform;
  }
  .lb-img {
    display: block;
    -webkit-user-drag: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lb-close,
  .lb-arrow {
    background: none;
    border: 0;
    color: #e6e6e6;
    cursor: pointer;
  }
  .lb-close {
    position: absolute;
    top: 28px;
    right: var(--inset);
    padding: 8px 0;
  }
  .lb-arrow {
    position: absolute;
    top: 50%;
    width: 64px;
    height: 96px;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
  }
  .lb-prev {
    left: 4px;
  }
  .lb-next {
    right: 4px;
  }
  .lb-arrow svg {
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }
  .lb-arrow:hover svg,
  .lb-arrow:focus-visible svg {
    opacity: 1;
  }
  .lb.first .lb-prev,
  .lb.last .lb-next {
    display: none;
  }
  .lb-bar {
    position: absolute;
    left: var(--inset);
    right: var(--inset);
    bottom: 28px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
  }
  .lb-bar p {
    margin: 0;
    color: #e6e6e6;
  }
  .lb-cap {
    min-width: 0;
  }
  .lb-count {
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  @media (pointer: coarse) {
    .lb-arrow {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .lb-close {
      top: 16px;
    }
    .lb-bar {
      bottom: 20px;
    }
  }
  :global(.js img[data-lb]) {
    cursor: zoom-in;
  }
</style>
