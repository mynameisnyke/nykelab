---
// Figma: GroupHeader — voyage sub-heading inside a Place or Year gallery.
import { fmtMonthYear, fmtN, type Voyage } from "../lib/voyages";

interface Props {
  voyage: Voyage;
  count: number;
}
const { voyage: v, count } = Astro.props;
---

<header class="group">
  <span class="dot" style={`--c:${v.color}`}></span>
  <h2>{v.title}</h2>
  <span class="meta">{fmtMonthYear(v.start)} · {fmtN(count)} photographs</span>
  {v.collection && <a class="open eyebrow" href={`/${v.collection}`}>Open voyage →</a>}
</header>

<style>
  .group {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 0;
    border-top: 1px solid var(--border-subtle);
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c);
    flex: none;
  }
  h2 {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 26px;
    line-height: 34px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .meta {
    flex: 1;
    font-family: var(--font-data);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-caption);
  }
  .open {
    color: var(--text-primary);
  }
  @media (max-width: 767px) {
    .group {
      flex-wrap: wrap;
      gap: 8px 12px;
      padding: 20px 0;
    }
    h2 {
      font-size: 22px;
      line-height: 30px;
    }
    .meta {
      flex-basis: 100%;
      order: 3;
    }
    .open {
      order: 4;
    }
  }
</style>
