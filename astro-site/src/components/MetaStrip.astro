---
// Figma: MetaStrip — facts computed from photo metadata.
interface Props {
  facts: { label: string; value: string }[];
}
const { facts } = Astro.props;
---

<dl class="strip">
  {facts.map((f) => <div class="fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
</dl>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 28px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 24px;
    border-left: 1px solid var(--border-subtle);
  }
  .fact:first-child {
    padding-left: 0;
    border-left: 0;
  }
  dt {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-caption);
  }
  dd {
    margin: 0;
    font-family: var(--font-title);
    font-size: 32px;
    line-height: 40px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  @media (max-width: 767px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 0;
      padding: 20px 0;
    }
    .fact,
    .fact:first-child {
      padding-left: 0;
      border-left: 0;
      gap: 6px;
    }
    dd {
      font-size: 22px;
      line-height: 30px;
    }
  }
</style>
