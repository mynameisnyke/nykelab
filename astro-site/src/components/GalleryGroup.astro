---
// One voyage's photographs inside a Place/Year/Event gallery: GroupHeader + rows of portrait tiles
// taken from the voyage's own collection, each captioned with its date and place.
import GroupHeader from "./GroupHeader.astro";
import MediaItem from "./MediaItem.astro";
import { photoCaption } from "../lib/gallery";
import type { Photo } from "../lib/collections";
import type { Voyage } from "../lib/voyages";

interface Props {
  voyage: Voyage;
  count: number;
  photos: Photo[];
  /** id for deep links (#westminster-2020) */
  anchor?: string;
}
const { voyage, count, photos, anchor } = Astro.props;
---

<section class="group" id={anchor}>
  <GroupHeader voyage={voyage} count={count} />
  {
    photos.length > 0 ? (
      <div class={`row n${Math.min(photos.length, 3)}`}>
        {photos.map((m) => (
          <figure class="reveal">
            <div class="ph">
              <MediaItem media={m} fit="cover" sizes={`(max-width: 767px) 100vw, ${Math.round(1312 / Math.min(photos.length, 3))}px`} />
            </div>
            <figcaption class="caption">{photoCaption(m) || voyage.title}</figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <p class="caption none">Photographs from this voyage are not published yet.</p>
    )
  }
</section>

<style>
  .group {
    scroll-margin-top: 24px;
    padding: var(--section-gap) var(--margin) 0;
  }
  .row {
    display: grid;
    gap: var(--gutter);
    padding-top: 32px;
    align-items: start;
  }
  .row.n1 {
    grid-template-columns: minmax(0, 644px);
  }
  .row.n2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .row.n3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  figure {
    margin: 0;
  }
  .ph {
    background: var(--bg-surface);
    overflow: hidden;
    aspect-ratio: 5 / 7;
  }
  .row.n2 .ph,
  .row.n1 .ph {
    aspect-ratio: 2 / 3;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  figcaption {
    margin-top: var(--caption-gap);
  }
  .none {
    margin: 8px 0 0;
  }
  @media (max-width: 767px) {
    .row.n1,
    .row.n2,
    .row.n3 {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-top: 24px;
    }
    .row .ph {
      aspect-ratio: 2 / 3;
    }
  }
</style>
