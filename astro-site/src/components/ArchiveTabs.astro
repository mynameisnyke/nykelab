---
// Figma: ArchiveTabs — Voyages · Places · Years (Events added in code; not in Figma yet)
interface Props {
  active: "voyages" | "places" | "years" | "events";
}
const { active } = Astro.props;
const tabs = [
  { id: "voyages", label: "Galleries", href: "/" },
  { id: "places", label: "Places", href: "/places" },
  { id: "years", label: "Years", href: "/years" },
  { id: "events", label: "Events", href: "/events" },
] as const;
---

<nav class="tabs" aria-label="Archive">
  {tabs.map((t) => <a href={t.href} data-astro-reload={t.href === "/" ? "" : undefined} class:list={{ on: t.id === active }} aria-current={t.id === active ? "page" : undefined}>{t.label}</a>)}
</nav>

<style>
  .tabs {
    display: flex;
    gap: 8px;
  }
  a {
    padding: 9px 18px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 12px;
    line-height: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  a:hover {
    color: var(--text-primary);
  }
  a.on {
    border-color: var(--border-strong);
    background: var(--fill-ring-soft);
    color: var(--text-primary);
  }
  /* Four tabs: tighten on phones so they fit one row at 360px; wrap rather than clip if a narrower screen needs it. */
  @media (max-width: 767px) {
    .tabs {
      flex-wrap: wrap;
      gap: 6px;
    }
    a {
      padding: 8px 12px;
      font-size: 11px;
      letter-spacing: 0.1em;
    }
  }
</style>
