---
// Figma: PostRow (Device=Desktop|Mobile, Cover=None|Thumb)
import { Image } from "astro:assets";
import Pill from "./Pill.astro";
import { formatDate, readingMinutes, type Post } from "../lib/journal";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, date, tags, cover, coverAlt } = post.data;
const minutes = readingMinutes(post.body);
---

<article class:list={["row", { "has-thumb": !!cover }]}>
  <div class="meta eyebrow">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span class="read">{minutes} min read</span>
  </div>
  <div class="body">
    <h2 class="title"><a class="stretch" href={`/journal/${post.id}`}>{title}</a></h2>
    <p class="summary">{description}</p>
    <ul class="tags">
      {tags.map((t) => <li><Pill label={t} size="small" /></li>)}
    </ul>
  </div>
  {
    cover && (
      <div class="thumb">
        <Image src={cover} alt={coverAlt} width={440} height={300} loading="lazy" />
      </div>
    )
  }
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 180px 1fr 110px;
    grid-template-areas: "meta body read";
    column-gap: 48px;
    padding: 40px 0;
    border-top: 1px solid var(--border-subtle);
    align-items: start;
  }
  .row.has-thumb {
    grid-template-columns: 180px 1fr 220px 110px;
    grid-template-areas: "meta body thumb read";
  }
  /* Date + read time sit in separate columns on desktop. */
  .meta {
    display: contents;
  }
  .meta time,
  .read {
    font-family: var(--font-data);
    font-weight: 400;
    letter-spacing: 0.04em;
  }
  .meta time {
    grid-area: meta;
  }
  .read {
    grid-area: read;
    text-align: right;
  }
  .body {
    grid-area: body;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .thumb {
    grid-area: thumb;
  }
  .thumb img {
    width: 220px;
    height: 150px;
    object-fit: cover;
  }
  .title {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 32px;
    line-height: 40px;
    letter-spacing: -0.01em;
  }
  .stretch::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .summary {
    margin: 0;
    color: var(--text-secondary);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
  .row:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  @media (max-width: 767px) {
    .row,
    .row.has-thumb {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 32px 0;
    }
    .thumb {
      order: -1;
    }
    .thumb img {
      width: 100%;
      height: 200px;
    }
    .meta {
      display: flex;
      order: 0;
    }
    .read {
      text-align: left;
    }
    .read::before {
      content: "·";
      margin: 0 0.6em;
    }
    .title {
      font-size: 26px;
      line-height: 32px;
    }
  }
</style>
