---
// Figma: Navbar (Surface=Page) + MenuOverlay (footer carries the JOURNAL link).
// The overlay here is the list + footer only; the preview image and sunburst
// from the Figma menu come with the photo pages.
import Logo from "./Logo.astro";
interface Props {
  /** "media" = sits over a photo (white icons/wordmark in both themes). */
  surface?: "page" | "media";
  /** Collections from the database; the static list below is only a fallback. */
  collections?: { slug: string; title: string }[];
}
const { surface = "page", collections } = Astro.props;
// Prerendered pages (the journal) can't read D1 at build time: they start with Home only and the
// script below fills in the collections from /api/collections when the menu first opens.
const fill = collections === undefined;
const chapters = [
  { label: "Home", href: "/" },
  ...(collections ?? []).map((c) => ({ label: c.title, href: `/${c.slug}` })),
];
const here = Astro.url.pathname;
const footer = [
  { label: "About", href: "/about" },
  { label: "Places", href: "/places" },
  { label: "Years", href: "/years" },
  { label: "Journal", href: "/journal" },
  // No Instagram URL yet: an entry without an href is not rendered.
  { label: "Instagram", href: "" },
  { label: "Email", href: "mailto:nyke@nykelab.nyc" },
].filter((f) => f.href);
---

<header class:list={["navbar", { media: surface === "media" }]}>
  <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle light / dark theme">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19.5 14.2A8 8 0 0 1 9.8 4.5a8 8 0 1 0 9.7 9.7Z"></path>
      <path d="M18 2.5v4M16 4.5h4"></path>
    </svg>
  </button>
  <a class="wordmark" href="/" data-astro-reload aria-label="NYKELAB home"><Logo /></a>
  <button class="icon-btn" type="button" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="menu">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <path d="M4 8h16M4 12h16M4 16h16"></path>
    </svg>
  </button>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="menu-bar">
    <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle light / dark theme">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19.5 14.2A8 8 0 0 1 9.8 4.5a8 8 0 1 0 9.7 9.7Z"></path>
        <path d="M18 2.5v4M16 4.5h4"></path>
      </svg>
    </button>
    <span class="wordmark"><Logo /></span>
    <button class="close" type="button" data-menu-close aria-label="Close menu">
      <span class="eyebrow-ui">Close</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13"></path>
      </svg>
    </button>
  </div>
  <nav class="menu-list" aria-label="Chapters">
    <ol data-fill={fill ? "" : undefined}>
      {
        chapters.map((c, i) => (
          <li>
            <span class="num">{i}</span>
            <a href={c.href} data-astro-reload={c.href === "/" ? "" : undefined}>{c.label}</a>
          </li>
        ))
      }
    </ol>
  </nav>
  <nav class="menu-footer" aria-label="Site links">
    {
      footer.map((f) => (
        <a href={f.href} aria-current={f.href !== "#" && (here === f.href || here.startsWith(f.href + "/")) ? "page" : undefined}>
          {f.label}
        </a>
      ))
    }
  </nav>
</div>

<script>
  document.addEventListener("click", async (e) => {
    if (!(e.target as Element).closest("[data-menu-open]")) return;
    const list = document.querySelector<HTMLOListElement>("ol[data-fill]");
    const home = list?.firstElementChild;
    if (!list || !home) return;
    list.removeAttribute("data-fill");
    try {
      const { collections } = (await (await fetch("/api/collections")).json()) as { collections: { slug: string; title: string }[] };
      collections.forEach((c, i) => {
        const li = home.cloneNode(true) as HTMLLIElement; // clones keep the scoped-style attributes
        li.querySelector(".num")!.textContent = String(i + 1);
        const a = li.querySelector("a")!;
        a.removeAttribute("data-astro-reload");
        a.href = `/${c.slug}`;
        a.textContent = c.title;
        list.appendChild(li);
      });
    } catch {
      /* the menu still works with Home and the footer links */
    }
  });
</script>

<style>
  .navbar,
  .menu-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--nav-height);
    padding: 0 var(--margin);
  }
  .navbar {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 10;
  }
  .navbar.media {
    --icon-primary: #fff;
    --text-primary: #fff;
  }
  .navbar > :last-child,
  .menu-bar > :last-child {
    justify-self: end;
  }
  .icon-btn,
  .close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--icon-primary);
    font: inherit;
    cursor: pointer;
  }
  .icon-btn {
    width: 32px;
    height: 32px;
  }
  .wordmark {
    display: inline-flex;
    color: var(--text-primary);
  }
  .eyebrow-ui {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    background: var(--bg-page);
    color: var(--text-primary);
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-list {
    flex: 1;
    padding: 86px var(--margin) 48px;
  }
  .menu-list ol {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu-list li {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }
  .num {
    width: 28px;
    padding-top: 6px;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 14px;
    color: var(--text-caption);
  }
  .menu-list a {
    font-family: var(--font-title);
    font-size: 84px;
    line-height: 100px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    opacity: var(--opacity-menu-inactive);
    transition: opacity 0.2s ease;
  }
  .menu-list a:hover,
  .menu-list a:focus-visible {
    opacity: 1;
  }
  .menu-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding: 0 var(--margin) 48px;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .menu-footer a {
    color: var(--text-secondary);
  }
  .menu-footer a:hover,
  .menu-footer a[aria-current] {
    color: var(--text-primary);
  }

  @media (max-width: 767px) {
    .icon-btn {
      width: 24px;
      height: 24px;
    }
    .menu-list {
      padding-top: 46px;
    }
    .menu-list li {
      gap: 12px;
    }
    .num {
      width: 18px;
      padding-top: 2px;
      font-size: 12px;
    }
    .menu-list a {
      font-size: 40px;
      line-height: 52px;
    }
    .menu-footer {
      gap: 20px;
      font-size: 12px;
    }
  }
</style>
