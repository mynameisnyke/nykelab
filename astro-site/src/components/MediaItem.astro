---
// One photo or video from the media table. Sizes come from the DB so the
// browser reserves space (no layout shift) and can pick the small variant.
// Videos are muted, inline loops; their src is attached and play/pause handled by src/scripts/video.ts.
// A photograph given an `alt` twin (another look of the same frame) is rendered as two layers: the twin sits over it, invisible,
// and develops into view while the page carries `data-hexify` (the HEXify toggle in the Navbar, see pages/[slug].astro).
import type { Photo } from "../lib/collections";

interface Props {
  media: Photo;
  sizes: string;
  eager?: boolean;
  fit?: "cover" | "natural";
  class?: string;
  /** The same photograph in another look, swapped in place by the page's toggle. */
  alt?: Photo;
  /** Stagger of that swap, in ms, so a screenful of photographs develops one after another. */
  delay?: number;
}
const { media: m, sizes, eager = false, fit = "natural", class: className, alt: twin, delay = 0 } = Astro.props;
const alt = m.place || m.caption.split("\n")[0] || "";
const hasSize = m.width > 0 && m.height > 0;
// The item's average colour shows while the file loads (validated as #rrggbb in the API, so safe in a style).
const placeholder = m.avgColour ? `background-color:${m.avgColour}` : undefined;
// Originals-first images list their generated widths; older rows have a small + main pair.
const srcsetOf = (p: Photo) =>
  p.urls.variants
    ? p.urls.variants.map((v) => `${v.url} ${v.width}w`).join(", ")
    : p.urls.small
      ? `${p.urls.small} ${p.smallWidth}w, ${p.urls.main} ${p.mainWidth}w`
      : undefined;
const srcset = srcsetOf(m);
---

{
  m.type === "video" ? (
    <video
      class:list={["media", fit, className]}
      style={placeholder}
      data-src={m.urls.main}
      data-eager={eager ? "" : undefined}
      poster={m.urls.poster}
      width={hasSize ? m.width : undefined}
      height={hasSize ? m.height : undefined}
      loop
      muted
      playsinline
      disablepictureinpicture
      disableRemotePlayback
      preload="none"
      aria-label={alt || undefined}
      data-media
      data-id={m.id}
      data-collection={m.collection}
    />
  ) : twin ? (
    <span class:list={["swap", fit, className]} style={delay ? `--swap-delay:${delay}ms` : undefined}>
      <img
        class:list={["media", fit]}
        src={m.urls.main}
        srcset={srcset}
        sizes={sizes}
        width={hasSize ? m.width : undefined}
        height={hasSize ? m.height : undefined}
        alt={alt}
        style={placeholder}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={eager ? "high" : undefined}
        data-media
        data-id={m.id}
        data-collection={m.collection}
      />
      <img class="media alt" src={twin.urls.main} srcset={srcsetOf(twin)} sizes={sizes} width={hasSize ? m.width : undefined} height={hasSize ? m.height : undefined} alt="" loading="lazy" decoding="async" aria-hidden="true" />
    </span>
  ) : (
    <img
      class:list={["media", fit, className]}
      src={m.urls.main}
      srcset={srcset}
      sizes={sizes}
      width={hasSize ? m.width : undefined}
      height={hasSize ? m.height : undefined}
      alt={alt}
      style={placeholder}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={eager ? "high" : undefined}
      data-media
      data-id={m.id}
      data-collection={m.collection}
    />
  )
}

<style>
  .media {
    display: block;
    max-width: 100%;
  }
  .media.natural {
    width: 100%;
    height: auto;
  }
  .media.cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Two looks of one photograph: the twin lies over the original and "develops" like an instant print when the page is HEXified. */
  .swap {
    display: block;
    position: relative;
    max-width: 100%;
  }
  .swap.natural {
    width: 100%;
  }
  .swap.cover {
    width: 100%;
    height: 100%;
  }
  .swap .media.alt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.015);
    filter: brightness(0.3) contrast(0.35) saturate(0.2) blur(10px);
    transition:
      opacity 0.8s ease var(--swap-delay, 0ms),
      filter 1.9s cubic-bezier(0.22, 0.61, 0.2, 1) var(--swap-delay, 0ms),
      transform 1.9s cubic-bezier(0.22, 0.61, 0.2, 1) var(--swap-delay, 0ms);
    pointer-events: none;
  }
  :global(html[data-hexify]) .swap .media.alt {
    opacity: 1;
    transform: none;
    filter: brightness(1) contrast(1) saturate(1) blur(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .swap .media.alt {
      transition-duration: 0.01ms;
      transition-delay: 0ms;
    }
  }
</style>
