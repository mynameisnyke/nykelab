---
// One photo or video from the media table. Sizes come from the DB so the
// browser reserves space (no layout shift) and can pick the small variant.
// Videos are muted, inline loops; their src is attached and play/pause handled by src/scripts/video.ts.
import type { Photo } from "../lib/collections";

interface Props {
  media: Photo;
  sizes: string;
  eager?: boolean;
  fit?: "cover" | "natural";
  class?: string;
}
const { media: m, sizes, eager = false, fit = "natural", class: className } = Astro.props;
const alt = m.place || m.caption.split("\n")[0] || "";
const hasSize = m.width > 0 && m.height > 0;
// Originals-first images list their generated widths; older rows have a small + main pair.
const srcset = m.urls.variants
  ? m.urls.variants.map((v) => `${v.url} ${v.width}w`).join(", ")
  : m.urls.small
    ? `${m.urls.small} ${m.smallWidth}w, ${m.urls.main} ${m.mainWidth}w`
    : undefined;
---

{
  m.type === "video" ? (
    <video
      class:list={["media", fit, className]}
      data-src={m.urls.main}
      data-eager={eager ? "" : undefined}
      poster={m.urls.poster}
      width={hasSize ? m.width : undefined}
      height={hasSize ? m.height : undefined}
      loop
      muted
      playsinline
      disablepictureinpicture
      disableRemotePlayback
      preload="none"
      aria-label={alt || undefined}
      data-media
      data-id={m.id}
      data-collection={m.collection}
    />
  ) : (
    <img
      class:list={["media", fit, className]}
      src={m.urls.main}
      srcset={srcset}
      sizes={sizes}
      width={hasSize ? m.width : undefined}
      height={hasSize ? m.height : undefined}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={eager ? "high" : undefined}
      data-media
      data-id={m.id}
      data-collection={m.collection}
    />
  )
}

<style>
  .media {
    display: block;
    max-width: 100%;
  }
  .media.natural {
    width: 100%;
    height: auto;
  }
  .media.cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
