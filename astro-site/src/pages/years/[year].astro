---
// Year gallery (Figma: GALLERIES / Year). The year is a huge numeral over the cover.
// Built from the voyages, like /years.
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import ChapterNav from "../../components/ChapterNav.astro";
import GalleryHero from "../../components/GalleryHero.astro";
import MetaStrip from "../../components/MetaStrip.astro";
import MonthBars from "../../components/MonthBars.astro";
import GalleryGroup from "../../components/GalleryGroup.astro";
import NextBlock from "../../components/NextBlock.astro";
import { loadGalleries } from "../../lib/gallery";
import { loadHomeData } from "../../lib/home-data";
import { deriveYears, fmtN, goldenShare, heroImage } from "../../lib/voyages";

export const prerender = false;

const { year: param = "" } = Astro.params;
const { nav, data } = await loadHomeData();
const { voyages, shots, images } = data;
const years = deriveYears(voyages, shots, images.length, images);
const at = years.findIndex((y) => String(y.year) === param);
const y = years[at];
if (!y) Astro.response.status = 404;
else Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=60, stale-while-revalidate=300");

const inYear = y ? shots.filter((s) => new Date(s.t).getUTCFullYear() === y.year) : [];
const max = Math.max(...years.flatMap((v) => v.monthCounts));
const order = y ? [...y.voyages].sort((a, b) => voyages[b].start - voyages[a].start) : [];
const n = (k: number, one: string, many: string) => `${k} ${k === 1 ? one : many}`;
const facts = y
  ? [
      { label: "Photographs", value: fmtN(y.count) },
      { label: "Galleries", value: String(y.voyages.length) },
      { label: "Countries", value: String(y.countries.length) },
      { label: "Most often", value: y.top ? `${y.top.focal}mm f/${y.top.f}` : "—" },
      { label: "Golden hour", value: `${Math.round(goldenShare(inYear) * 100)}%` },
    ]
  : [];
const { groups, heroVideo, heroPhoto } = y ? await loadGalleries(voyages, order, y.year) : { groups: [], heroVideo: undefined, heroPhoto: undefined };
const next = y && years.length > 1 ? years[(at + 1) % years.length] : undefined;
const hero = y ? images[heroImage(images, y.photos[0] ?? -1, y.photos)] : undefined;
---

<Base title={y ? `${y.year} — nykelab` : "Not found — nykelab"} description={y ? `${y.year}: ${fmtN(y.count)} photographs from ${n(y.voyages.length, "gallery", "galleries")}.` : "Nothing here."} image={hero?.src}>
  <Navbar surface="media" collections={nav} />
  {
    !y ? (
      <main class="empty">
        <p class="eyebrow">Nothing here.</p>
        <a class="eyebrow" href="/years">← Years</a>
      </main>
    ) : (
      <main>
        <GalleryHero title={String(y.year)} numeral subtitle={`${fmtN(y.count)} photographs · ${n(y.voyages.length, "gallery", "galleries")} · ${n(y.countries.length, "country", "countries")}`} crumb={{ label: "Years", href: "/years" }} image={hero} video={heroVideo} photo={heroPhoto} />
        <section class="facts"><MetaStrip facts={facts} /></section>
        <section class="months"><MonthBars counts={y.monthCounts} voyageByMonth={y.monthVoyage} voyages={voyages} max={max} year={y.year} bw={56} label /></section>
        {groups.map((g) => <GalleryGroup {...g} count={inYear.filter((s) => s.v === voyages.indexOf(g.voyage)).length} />)}
        {next && <div class="next-wrap"><NextBlock eyebrow="Next year" title={String(next.year)} meta={`${fmtN(next.count)} photographs · ${n(next.voyages.length, "gallery", "galleries")}`} href={`/years/${next.year}`} image={images[next.photos[0]]} /></div>}
      </main>
    )
  }
  <ChapterNav />
</Base>

<script>
  import { initPhotos } from "../../scripts/photos";
  document.addEventListener("astro:page-load", initPhotos);
</script>

<style>
  .facts {
    padding: 96px var(--margin) 0;
  }
  .months {
    padding: 48px var(--margin) 0;
  }
  .next-wrap {
    padding-top: var(--section-gap);
    padding-bottom: 120px;
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 100vh;
  }
  @media (max-width: 767px) {
    .facts {
      padding-top: 48px;
    }
    .months {
      padding-top: 32px;
    }
    .next-wrap {
      padding-bottom: 72px;
    }
  }
</style>
