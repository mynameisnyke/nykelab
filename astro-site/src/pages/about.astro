---
// About: Figma "AboutHero". Server-rendered only so the chapter nav reflects the database.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Pill from "../components/Pill.astro";
import ChapterNav from "../components/ChapterNav.astro";
import { getNav } from "../lib/collections";
import photo from "../assets/journal/tetons.jpg";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=60, stale-while-revalidate=300");

const nav = await getNav();
const bio =
  "Photographer and developer in New York. A decade in digital media: photographs published, applications built. All photos and videos are owned and captured by Nyke Harewood.";
---

<Base title="About — nykelab" description={bio}>
  <Navbar surface="media" collections={nav} />
  <main>
    <Image class="photo" src={photo} alt="" widths={[800, 1440, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="dim"></div>
    <div class="scrim"></div>
    <div class="copy">
      <h1>Nyke Harewood</h1>
      <p class="bio">{bio}</p>
      <div class="links">
        <Pill label="GitHub" href="https://github.com/mynameisnyke" surface="media" external />
        <Pill label="LinkedIn" href="https://www.linkedin.com/in/nyke-harewood/" surface="media" external />
        <Pill label="Email" href="mailto:nyke@nykelab.nyc" surface="media" />
      </div>
    </div>
  </main>
  <ChapterNav />
</Base>

<style>
  main {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    color: #fff;
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1); /* Figma: "photo · B&W" */
  }
  .dim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5); /* overlay/dim */
  }
  .scrim {
    position: absolute;
    inset: auto 0 0 0;
    height: 62%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  }
  .copy {
    position: absolute;
    left: var(--inset);
    right: var(--inset);
    bottom: 128px;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 64px;
    line-height: 72px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .bio {
    margin: 0;
    color: #e6e6e6;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 0;
  }
  @media (max-width: 767px) {
    h1 {
      font-size: 40px;
      line-height: 46px;
    }
    .copy {
      bottom: 100px;
      gap: 16px;
    }
  }
</style>
