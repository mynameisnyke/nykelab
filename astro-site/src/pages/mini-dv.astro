---
// Mini DV: a walk through a scan of my desk, then the tapes in its drawer and the Sony deck that plays them. Scroll to walk along the
// desk (the camera glides, captions come and go, like the New York Times' Jackson Heights tour). Choose a tape by name, or pull the
// drawer and pick one: it comes out of its case, goes into the deck, and plays on the deck's own screen.
// Local branch for now (mini-dv). The world is public/minidv/scan.glb (a Polycam capture). In dev the videos stream from the
// Mini DV folder (astro.config.mjs); see src/lib/minidv.ts.
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import ChapterNav from "../components/ChapterNav.astro";
import MiniDvMark from "../components/MiniDvMark.astro";
import { TAPES, runtime } from "../lib/minidv";

// one caption per stop of the walk (src/scripts/minidv/world.ts, STOPS)
const captions = [
  { title: "Mini DV", text: "Fourteen tapes on a desk, and the deck that plays them." },
  { text: "This is the desk, from the chair." },
  { text: "An arcade stick." },
  { text: "A Sony Mini DV deck." },
  { text: "A Street Fighter art book." },
  { text: "And the tapes, in a drawer under the shelf.", hint: "Pull it open, or choose one by name." },
];
---

<Base title="Mini DV — nykelab" description="A walk along my desk: the drawer of Mini DV tapes and the Sony deck that plays them. Choose a tape and watch it go in.">
  <div class="md-track" aria-hidden="true"></div>

  <main class="md" aria-label="Mini DV tapes on a desk">
    <div id="md-stage" class="md-stage"></div>
    <div class="md-fx" aria-hidden="true"></div>
    <p id="md-hint" class="md-hint" hidden><span>Pull the drawer</span></p>
    <p id="md-tip" class="md-tip" hidden aria-hidden="true"></p>
  </main>

  <div class="md-caps">
    {
      captions.map((c, i) => (
        <div class="md-cap" data-stop={i}>
          {c.title ? <h1>{c.title}</h1> : null}
          <p>{c.text}</p>
          {c.hint ? <p class="sub">{c.hint}</p> : null}
        </div>
      ))
    }
  </div>
  <p id="md-cue" class="md-cue">Scroll</p>

  <Navbar surface="media" />

  <section id="md-shelf" class="md-shelf collapsed" aria-label="Tapes">
    <div class="md-shelf-head">
      <button id="md-shelf-toggle" class="md-shelf-toggle" type="button" aria-expanded="false" aria-controls="md-list">
        <MiniDvMark size={20} />
        <span class="title">Tapes</span>
        <span class="count">{TAPES.length}</span>
      </button>
      <button id="md-sound" class="md-sound" type="button" aria-pressed="true" aria-label="Desk sounds on, tap to turn off">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4Z"></path>
          <path class="wave" d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.8a7.5 7.5 0 0 1 0 10.4"></path>
        </svg>
      </button>
    </div>
    <ul id="md-list" class="md-list">
      {
        TAPES.map((t, i) => (
          <li>
            <button class="md-tape" type="button" data-tape={t.id}>
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <span class="t">
                {t.title}
                {t.note && <small>{t.note}</small>}
              </span>
              <span class="d">{runtime(t.seconds)}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <p id="md-status" class="md-status" role="status" aria-live="polite"></p>

  <!-- only used for the full-screen picture (and as the screen when there is no WebGL) -->
  <div id="md-screen" class="md-screen" hidden></div>

  <section id="md-hud" class="md-hud" aria-label="Sony deck controls" hidden>
    <div class="md-hud-title">
      <p class="eyebrow">On the deck</p>
      <h2 id="md-now"></h2>
    </div>
    <div class="md-bar">
      <button class="md-ic" type="button" data-act="rew" aria-label="Rewind (tap to jump back 10 seconds, hold to search)" title="Rewind">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 6v12l-8-6zM21 6v12l-8-6z" /></svg>
      </button>
      <button class="md-ic play" type="button" data-act="play" aria-label="Pause" title="Play / pause">
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14l12-7z" /></svg>
      </button>
      <button class="md-ic" type="button" data-act="stop" aria-label="Stop" title="Stop">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h12v12H6z" /></svg>
      </button>
      <button class="md-ic" type="button" data-act="ff" aria-label="Fast forward (tap to jump ahead 10 seconds, hold to search)" title="Fast forward">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 6v12l8-6zM3 6v12l8-6z" /></svg>
      </button>
      <button class="md-ic" type="button" data-act="eject" aria-label="Eject the tape" title="Eject">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5l8 9H4zM5 17h14v2.5H5z" /></svg>
      </button>
      <span id="md-time" class="md-time">0:00 / 0:00</span>
      <input id="md-seek" class="md-seek" type="range" min="0" max="1000" value="0" aria-label="Position on the tape" />
      <button class="md-ic sm" type="button" data-act="vol-down" aria-label="Volume down" title="Volume down">−</button>
      <button class="md-ic sm" type="button" data-act="vol-up" aria-label="Volume up" title="Volume up">+</button>
      <button id="md-full" class="md-btn" type="button">Full screen</button>
      <button class="md-btn" type="button" data-hud-close>Back to desk</button>
    </div>
  </section>

  <ChapterNav />
  <noscript><p class="md-noscript">The desk needs JavaScript to open its drawer.</p></noscript>
</Base>

<script>
  import { initMiniDv } from "../scripts/minidv";
  let dispose: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    if (document.getElementById("md-stage")) dispose = initMiniDv();
  });
  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = undefined;
  });
</script>

<style>
  :global(html),
  :global(body) {
    background: #0b0907;
    color: #f2f2f2;
  }
  :global(html.md-locked) {
    overflow: hidden;
  }
  /* the walk is as long as this track is tall */
  .md-track {
    height: 640vh;
  }
  .md {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #0b0907;
  }
  .md-stage {
    position: absolute;
    inset: 0;
  }
  .md-stage :global(canvas) {
    display: block;
    touch-action: pan-y;
  }
  .md-stage.no-webgl {
    background: #0b0907 url("/minidv/desk.jpg") center / contain no-repeat;
  }
  /* the grain and falling-off of a photograph, over the whole scene */
  .md-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 46%, transparent 52%, rgba(6, 5, 4, 0.62) 100%),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0.55 0'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
    mix-blend-mode: normal;
    opacity: 1;
  }

  /* the captions of the walk */
  .md-caps {
    position: fixed;
    left: 50%;
    bottom: 118px;
    transform: translateX(-50%);
    z-index: 5;
    width: min(700px, calc(100vw - 32px));
    height: 190px;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  :global(html.md-locked) .md-caps {
    opacity: 0;
  }
  .md-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    text-align: center;
    color: #fff;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.9), 0 0 3px rgba(0, 0, 0, 0.6);
  }
  .md-cap h1 {
    margin: 0 0 6px;
    font-family: var(--font-title);
    font-weight: 400;
    font-size: clamp(44px, 9vw, 96px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .md-cap p {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(19px, 2.6vw, 27px);
    line-height: 1.3;
  }
  .md-cap .sub {
    margin-top: 8px;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .md-cue {
    position: fixed;
    left: 50%;
    bottom: 74px;
    transform: translateX(-50%);
    z-index: 5;
    margin: 0;
    pointer-events: none;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 10px #000;
    animation: md-nudge 1.9s ease-in-out infinite;
  }
  .md-cue[hidden] {
    display: none;
  }
  .md-cue::after {
    content: " ↓";
  }
  :global(html.md-locked) .md-cue {
    display: none;
  }
  @keyframes md-nudge {
    50% {
      transform: translate(-50%, 6px);
    }
  }

  .md-hint,
  .md-tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    margin: 0;
    pointer-events: none;
    font-family: var(--font-ui);
  }
  .md-hint[hidden],
  .md-tip[hidden] {
    display: none;
  }
  .md-hint span {
    display: inline-block;
    padding: 7px 12px 7px 14px;
    border-radius: 999px;
    background: rgba(8, 6, 4, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.4);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    animation: md-bob 1.9s ease-in-out infinite;
  }
  .md-hint span::after {
    content: " ↓";
  }
  @keyframes md-bob {
    50% {
      transform: translateY(7px);
    }
  }
  .md-tip {
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(8, 6, 4, 0.86);
    color: #fff;
    font-weight: 500;
    font-size: 13px;
    white-space: nowrap;
  }

  /* the list of tapes, by name */
  .md-shelf {
    position: fixed;
    z-index: 6;
    left: var(--inset);
    top: calc(var(--nav-height) + 14px);
    width: 276px;
    max-height: calc(100dvh - var(--nav-height) - 120px);
    display: flex;
    flex-direction: column;
    background: rgba(12, 10, 8, 0.66);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    overflow: hidden;
  }
  :global(html.md-watching) .md-shelf {
    display: none;
  }
  .md-shelf-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 6px 4px 4px;
  }
  .md-shelf-toggle,
  .md-sound {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: 0;
    color: #fff;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 10px;
  }
  .md-shelf-toggle {
    padding: 10px 12px;
  }
  .md-shelf-toggle .count {
    color: #9a958a;
    font-family: var(--font-data);
    letter-spacing: 0;
  }
  .md-sound {
    width: 36px;
    height: 36px;
    justify-content: center;
    padding: 0;
  }
  .md-sound[aria-pressed="false"] .wave {
    display: none;
  }
  .md-list {
    margin: 0;
    padding: 2px 6px 8px;
    list-style: none;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .md-shelf.collapsed .md-list {
    display: none;
  }
  .md-tape {
    display: grid;
    grid-template-columns: 26px 1fr auto;
    align-items: baseline;
    gap: 8px;
    width: 100%;
    padding: 9px 8px;
    text-align: left;
    background: none;
    border: 0;
    border-radius: 8px;
    color: #ece8e0;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 14px;
    line-height: 1.25;
    cursor: pointer;
  }
  .md-tape .n,
  .md-tape .d {
    font-family: var(--font-data);
    font-size: 12px;
    color: #9a958a;
  }
  .md-tape small {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    font-weight: 400;
    color: #9a958a;
  }
  .md-tape:hover,
  .md-tape.hover,
  .md-tape:focus-visible {
    background: rgba(255, 255, 255, 0.1);
  }
  .md-tape:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
  }
  .md-tape[aria-current] {
    background: rgba(255, 255, 255, 0.16);
  }
  .md-tape[aria-current] .n {
    font-size: 0;
  }
  .md-tape[aria-current] .n::before {
    content: "▶";
    font-size: 12px;
    color: #fff;
  }

  .md-status {
    position: fixed;
    z-index: 6;
    top: calc(var(--nav-height) + 14px);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    max-width: min(92vw, 480px);
    text-align: center;
    pointer-events: none;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: #ded9ce;
    text-shadow: 0 1px 10px #000;
  }
  :global(html.md-watching) .md-status {
    opacity: 0;
  }

  /* watching: the deck's controls */
  .md-hud {
    position: fixed;
    inset: 0;
    z-index: 8;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .md-hud[hidden] {
    display: none;
  }
  .md-hud:global(.open) {
    opacity: 1;
  }
  .md-hud-title {
    position: absolute;
    left: var(--inset);
    top: calc(var(--nav-height) + 14px);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.9);
  }
  .md-hud-title .eyebrow {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #cfc9bc;
  }
  .md-hud-title h2 {
    margin: 2px 0 0;
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .md-bar {
    position: absolute;
    left: 50%;
    bottom: 64px;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: max-content;
    max-width: calc(100vw - 24px);
    padding: 10px 14px;
    border-radius: 18px;
    background: rgba(10, 8, 6, 0.72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    pointer-events: auto;
  }
  .md-ic {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }
  .md-ic svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .md-ic.sm {
    width: 32px;
    height: 32px;
    font-size: 18px;
  }
  .md-ic:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .md-ic:focus-visible,
  .md-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .md-ic.play .i-play {
    display: none;
  }
  .md-hud:not([data-state="playing"]) .md-ic.play .i-pause {
    display: none;
  }
  .md-hud:not([data-state="playing"]) .md-ic.play .i-play {
    display: block;
  }
  .md-time {
    min-width: 96px;
    margin-left: 4px;
    font-family: var(--font-data);
    font-size: 12px;
    color: #d7d2c6;
    white-space: nowrap;
  }
  .md-seek {
    width: 180px;
    min-width: 80px;
    accent-color: #fff;
  }
  .md-btn {
    padding: 9px 13px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(8, 6, 4, 0.5);
    color: #fff;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
  }
  .md-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  /* the screen's picture, big: only while in full screen, or when there is no WebGL */
  .md-screen {
    position: fixed;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    z-index: 7;
    width: min(92vw, 640px);
    background: #000;
  }
  .md-screen[hidden] {
    display: none;
  }
  .md-screen :global(canvas) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
  }
  .md-screen:fullscreen {
    inset: 0;
    left: 0;
    top: 0;
    transform: none;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }
  .md-screen:fullscreen :global(canvas) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
  }
  .md-noscript {
    position: fixed;
    inset: 40% 0 auto;
    text-align: center;
    z-index: 9;
  }

  @media (max-width: 767px) {
    .md-shelf {
      left: 12px;
      right: 12px;
      top: auto;
      bottom: 64px;
      width: auto;
      max-height: 46dvh;
    }
    .md-status {
      top: calc(var(--nav-height) - 6px);
      font-size: 12px;
    }
    .md-caps {
      bottom: 126px;
    }
    .md-hud-title {
      left: 16px;
    }
    .md-seek {
      flex-basis: 100%;
      order: 9;
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .md-hint span,
    .md-cue {
      animation: none;
    }
    .md-hud {
      transition: none;
    }
  }
</style>
