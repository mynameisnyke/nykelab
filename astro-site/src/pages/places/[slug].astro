---
// Place gallery (Figma: GALLERIES / Place). One group per voyage made in the place.
// Built from the voyages, like /places.
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import ChapterNav from "../../components/ChapterNav.astro";
import GalleryHero from "../../components/GalleryHero.astro";
import MetaStrip from "../../components/MetaStrip.astro";
import GalleryGroup from "../../components/GalleryGroup.astro";
import NextBlock from "../../components/NextBlock.astro";
import { loadHomeData } from "../../lib/home-data";
import { derivePlaces, fmtN, fmtSpan, goldenShare, heroImage, pickPhotos, topSetting } from "../../lib/voyages";

export const prerender = false;

const { slug = "" } = Astro.params;
const { nav, data } = await loadHomeData();
const { voyages, shots, images } = data;
const places = derivePlaces(voyages, (v) => v.kind !== "event");
const at = places.findIndex((p) => p.slug === slug);
const place = places[at];
if (!place) Astro.response.status = 404;
else Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=60, stale-while-revalidate=300");

const order = place ? [...place.voyages].sort((a, b) => voyages[b].start - voyages[a].start) : [];
const mine = place ? shots.filter((s) => place.voyages.includes(s.v)) : [];
const top = topSetting(mine);
const facts = place
  ? [
      { label: "Photographs", value: fmtN(place.count) },
      { label: "Voyages", value: String(place.voyages.length) },
      { label: "Dates", value: fmtSpan(place.start, place.end) },
      { label: "Most often", value: top ? `${top.focal}mm f/${top.f}` : "—" },
      { label: "Golden hour", value: `${Math.round(goldenShare(mine) * 100)}%` },
    ]
  : [];
const groups = order.map((vi, k) => ({ voyage: voyages[vi], count: voyages[vi].count, shots: pickPhotos(shots, images, vi, k % 2 === 0 ? 3 : 2) }));
const next = place && places.length > 1 ? places[(at + 1) % places.length] : undefined;
const hero = place ? images[heroImage(images, place.cover)] : undefined;
---

<Base title={place ? `${place.name} — nykelab` : "Not found — nykelab"} description={place ? `${place.name}, ${place.country}: ${fmtN(place.count)} photographs, ${fmtSpan(place.start, place.end)}.` : "Nothing here."} image={hero?.src}>
  <Navbar surface="media" collections={nav} />
  {
    !place ? (
      <main class="empty">
        <p class="eyebrow">Nothing here.</p>
        <a class="eyebrow" href="/places">← Places</a>
      </main>
    ) : (
      <main>
        <GalleryHero title={place.name} subtitle={`${place.country} · ${fmtN(place.count)} photographs`} crumb={{ label: "Places", href: "/places" }} image={hero} />
        <section class="facts"><MetaStrip facts={facts} /></section>
        {groups.map((g) => <GalleryGroup {...g} images={images} />)}
        {next && <div class="next-wrap"><NextBlock eyebrow="Next place" title={next.name} meta={`${next.country} · ${fmtN(next.count)} photographs`} href={`/places/${next.slug}`} image={images[next.cover]} /></div>}
      </main>
    )
  }
  <ChapterNav />
</Base>

<script>
  import { initPhotos } from "../../scripts/photos";
  document.addEventListener("astro:page-load", initPhotos);
</script>

<style>
  .facts {
    padding: 96px var(--margin) 0;
  }
  .next-wrap {
    padding-top: var(--section-gap);
    padding-bottom: 120px;
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 100vh;
  }
  @media (max-width: 767px) {
    .facts {
      padding-top: 48px;
    }
    .next-wrap {
      padding-bottom: 72px;
    }
  }
</style>
