---
// Infinite Azure: an endless, parallaxed scroll of photographs over the Infinite Azure loop, with its music.
// Local branch for now (infinite-azure). The background loop, poster and music live in storage under azure/ (scripts/publish-azure.mjs).
import "@fontsource-variable/orbitron";
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import ChapterNav from "../components/ChapterNav.astro";
import InfinityMark from "../components/InfinityMark.astro";
import { getAzureFeed } from "../lib/azure";
import { getNav } from "../lib/collections";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=60, stale-while-revalidate=300");

const [feed, nav] = await Promise.all([getAzureFeed(), getNav()]);
---

<Base title="Infinite Azure — nykelab" description="An endless scroll of photographs over the Infinite Azure loop and music.">
  <video id="az-bg" class="az-bg" src="/m/azure/background.mp4" poster="/m/azure/background.jpg" muted loop playsinline autoplay preload="auto" aria-hidden="true"></video>
  <div class="az-scrim" aria-hidden="true"></div>

  <Navbar surface="media" collections={nav} />

  <main id="az-stage" class="az" aria-label="Infinite Azure: photographs, endlessly">
    <div id="az-feed"></div>
  </main>
  <canvas id="az-hit" class="az-hit" aria-hidden="true"></canvas>
  <!-- the combo counter: one hit for every photograph that lands -->
  <div id="az-combo" class="az-combo" aria-hidden="true"><span id="az-combo-n" class="n">0</span><span class="label">Hit Combo</span></div>

  <audio id="az-audio" src="/m/azure/infinite-azure.m4a" loop preload="none"></audio>
  <button id="az-sound" class="az-sound" type="button" aria-pressed="false" aria-label="Sound off, tap to play" hidden>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4Z"></path>
      <path class="wave" d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.8a7.5 7.5 0 0 1 0 10.4"></path>
      <path class="mute" d="M15.5 9.5l5 5M20.5 9.5l-5 5"></path>
    </svg>
  </button>

  <div id="az-intro" class="az-intro" role="dialog" aria-modal="false" aria-label="Infinite Azure">
    <div class="az-intro-inner">
      <span class="az-streaks" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <span class="az-mark"><InfinityMark size={48} /></span>
      <h1 class="az-word" data-text="Infinite Azure"><span>Infinite Azure</span></h1>
      <p class="az-sub">Red Hook, Brooklyn</p>
      <p class="eyebrow">Scroll. It does not end.</p>
      <div class="az-actions">
        <button id="az-enter" type="button">Enter with sound</button>
        <button id="az-silent" type="button" class="quiet">Without sound</button>
      </div>
    </div>
  </div>

  <ChapterNav />
  <script type="application/json" id="az-data" set:html={JSON.stringify(feed)} />
</Base>

<script>
  import { initAzure } from "../scripts/azure";
  let dispose: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    if (document.getElementById("az-feed")) dispose = initAzure();
  });
  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = undefined;
  });
</script>

<style>
  :global(html.az-locked),
  :global(html.az-locked body) {
    overflow: hidden;
  }
  /* The loop is a fixed layer *above* the body's own background (z-index 0, not negative): a negative layer is painted under
     <body>'s background, and which stylesheet wins for that background depends on build order, so it once hid the video. */
  :global(body) {
    color: #fff;
  }
  .az-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    background: #07131d;
  }
  .az-scrim {
    position: fixed;
    inset: 0;
    z-index: 0; /* later in the page than the video, so it lies over it */
    background: linear-gradient(to bottom, rgba(3, 12, 20, 0.35), rgba(3, 12, 20, 0.12) 40%, rgba(3, 12, 20, 0.4));
    pointer-events: none;
  }
  .az {
    position: relative;
    z-index: 1;
    overflow-x: clip;
  }
  #az-feed {
    position: relative;
  }
  /* the pieces are created by the script */
  :global(.az-scene) {
    position: relative;
    width: 100%;
  }
  :global(.az-piece) {
    position: absolute;
    margin: 0;
    will-change: transform;
  }
  /* nothing shows (not even its shadow) until the photograph lands */
  :global(.az-piece.landed) {
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.45);
    background: #0b1a26;
  }
  :global(.az-piece img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  :global(.az-piece.landed img) {
    animation: az-slam 0.46s cubic-bezier(0.2, 0.9, 0.25, 1) both;
  }
  @keyframes az-slam {
    0% {
      opacity: 0;
      transform: scale(1.2) rotate(-1.4deg);
      filter: brightness(2.4) contrast(1.15);
    }
    30% {
      opacity: 1;
      filter: brightness(1.55);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.az-piece.landed img) {
      animation: az-fade 0.5s ease both;
    }
    @keyframes az-fade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  .az-hit {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 15;
    pointer-events: none;
  }

  .az-combo {
    position: fixed;
    left: 0;
    top: 34vh;
    z-index: 16;
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 6px 90px 16px var(--inset);
    font-family: var(--font-ui);
    font-style: italic;
    color: #fff;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(3, 10, 18, 0.5), rgba(3, 10, 18, 0.28) 60%, rgba(3, 10, 18, 0));
    opacity: 0;
    transform: translateX(-28px);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.2, 0.9, 0.25, 1);
  }
  .az-combo.on {
    opacity: 1;
    transform: none;
  }
  .az-combo .n {
    display: inline-block;
    min-width: 0.6em;
    font-weight: 800;
    font-size: 72px;
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    transform-origin: 20% 70%;
    text-shadow: 0 0 22px rgba(255, 60, 100, 0.6), 0 2px 0 rgba(0, 0, 0, 0.45);
  }
  .az-combo .label {
    font-weight: 700;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.45);
  }
  /* the red-pink bar under the text, cut on the slant */
  .az-combo::after {
    content: "";
    position: absolute;
    left: var(--inset);
    right: 24px;
    bottom: 6px;
    height: 6px;
    background: linear-gradient(90deg, #ff4a76, #c2183f 55%, rgba(194, 24, 63, 0));
    clip-path: polygon(0 0, 100% 0, 97% 100%, 0 100%);
    box-shadow: 0 0 14px rgba(255, 60, 100, 0.55);
  }

  .az-sound {
    position: fixed;
    right: var(--inset);
    bottom: 58px; /* above the view counter */
    z-index: 21;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    color: #fff;
    background: none;
    border: 0;
    cursor: pointer;
    mix-blend-mode: difference;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  .az-sound:hover,
  .az-sound:focus-visible {
    opacity: 1;
  }
  .az-sound[data-on="1"] .mute,
  .az-sound[data-on="0"] .wave {
    display: none;
  }
  .az-sound[hidden] {
    display: none;
  }

  .az-intro {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
    background: radial-gradient(ellipse at center, rgba(4, 14, 24, 0.35), rgba(4, 14, 24, 0.78));
    backdrop-filter: blur(3px);
    transition: opacity 0.65s ease;
  }
  .az-intro.out {
    opacity: 0;
    pointer-events: none;
  }
  .az-intro[hidden] {
    display: none;
  }
  .az-intro-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .az-mark {
    color: #fff;
    opacity: 0.9;
  }
  /* the wordmark: wide, slanted, squared lettering in brushed chrome with a dark bevel, like an arcade title card */
  .az-word {
    position: relative;
    margin: 6px 0 0;
    font-family: "Orbitron Variable", var(--font-ui);
    font-weight: 900;
    font-size: clamp(26px, 6.6vw, 100px);
    line-height: 1.05;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: skewX(-14deg) scaleX(1.1);
  }
  .az-word > span {
    position: relative;
    z-index: 1;
    display: inline-block;
    padding: 0 0.04em;
    background: linear-gradient(180deg, #ffffff 0%, #dbe3e6 26%, #9aa7ad 46%, #46535a 51%, #b4c0c5 56%, #f1f6f7 76%, #87949a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: 1px rgba(12, 20, 26, 0.55);
    filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.35));
  }
  .az-word::before {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    padding: 0 0.04em;
    z-index: 0;
    color: transparent;
    -webkit-text-stroke: 0.13em #0b1319;
    filter: drop-shadow(0 0.07em 0.12em rgba(0, 0, 0, 0.7));
  }
  .az-sub {
    margin: 4px 0 0;
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: #dbe7ee;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }
  .az-sub::before,
  .az-sub::after {
    content: "";
    width: 34px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(219, 231, 238, 0.8));
  }
  .az-sub::after {
    transform: scaleX(-1);
  }
  /* a few thin streaks of light behind the title, like the scan lines of a stage card */
  .az-streaks {
    position: absolute;
    left: 50%;
    top: 30%;
    width: min(92vw, 1000px);
    height: 120px;
    transform: translateX(-50%);
    pointer-events: none;
    opacity: 0.8;
  }
  .az-streaks i {
    position: absolute;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, rgba(176, 205, 225, 0.75) 25%, rgba(235, 245, 250, 0.9) 50%, rgba(176, 205, 225, 0.6) 80%, transparent);
    filter: blur(0.4px);
  }
  .az-streaks i:nth-child(1) { top: 4px; left: 6%; width: 16%; }
  .az-streaks i:nth-child(2) { top: 18px; left: 52%; width: 28%; opacity: 0.7; }
  .az-streaks i:nth-child(3) { top: 40px; left: 20%; width: 38%; height: 1px; }
  .az-streaks i:nth-child(4) { top: 62px; left: 64%; width: 20%; }
  .az-streaks i:nth-child(5) { top: 90px; left: 10%; width: 24%; height: 1px; opacity: 0.6; }
  .eyebrow {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #dfe9f0;
  }
  .az-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 18px;
  }
  .az-actions button {
    font: inherit;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    padding: 12px 26px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .az-actions button:hover,
  .az-actions button:focus-visible {
    background: #fff;
    color: #050f18;
  }
  .az-actions .quiet {
    border-color: transparent;
    padding: 4px 8px;
    color: #cfdbe4;
  }
  .az-actions .quiet:hover,
  .az-actions .quiet:focus-visible {
    background: transparent;
    color: #fff;
    text-decoration: underline;
  }
  @media (max-width: 767px) {
    .az-sub {
      font-size: 11px;
      letter-spacing: 0.26em;
    }
    .az-sound {
      bottom: 74px; /* above the view counter and the bottom nav */
      right: 12px;
    }
    .az-combo {
      top: 24vh;
      gap: 10px;
      padding-right: 56px;
    }
    .az-combo .n {
      font-size: 48px;
    }
    .az-combo .label {
      font-size: 21px;
    }
  }
</style>
