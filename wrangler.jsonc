{
  // One Worker serves the built Vue site (static assets) and the API.
  // D1 / R2 are auto-provisioned on first `wrangler deploy` (no IDs needed).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nykelab",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // Everything else is a static file / SPA route; these hit the Worker first.
    "run_worker_first": ["/api/*", "/m/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nykelab",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nykelab-media" }],
  // Sized image variants are generated from originals (worker/src/public.ts).
  "images": { "binding": "IMAGES" },
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "nykelab_events" }
  ],
  "vars": {
    // Anything other than "development" requires a valid Cloudflare Access JWT on /api/admin/*.
    "ENVIRONMENT": "production",
    // Set these after creating the Access application (see README "Deploying").
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Optional comma-separated allowlist of admin emails (extra check on top of Access).
    "ADMIN_EMAILS": "",
    // Needed only for the /admin stats tab (plus secret CF_API_TOKEN).
    "CF_ACCOUNT_ID": ""
  }
}
